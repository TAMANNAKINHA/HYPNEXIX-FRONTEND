# Copy to .env.local (scripts/setup.sh --frontend does this automatically).
# Backend base URL (no trailing slash). Must match backend PORT and allow this
# origin via the backend's FRONTEND_URL.
VITE_BACKEND_URL=http://localhost:5000

# The payments screens run on built-in mock data unless this is exactly "false".
# Leave "true" for UI-only work. Set "false" only once the frontend sends the
# role bearer tokens the backend requires (see KNOWN_BUGS.md INT-005).
VITE_USE_MOCK=true
